# Public TTACart demonstration account; replace with your test environment settings.
TTA_ENV=qa
QA_BASE_URL=https://app.thetestingacademy.com
API_BASE_URL=https://restful-booker.herokuapp.com
STANDARD_USER=standard_user
TTA_SECRET=tta_secret
CHECKOUT_ITEM_ID=test-allthethings-tshirt-red

# All provider keys are intentionally blank. Never commit your populated .env.
AI_ENABLED=true
AI_PROVIDER=deepseek
# Blank model/base URL use the selected provider's defaults.
AI_MODEL=
AI_BASE_URL=
AI_TIMEOUT_MS=15000
AI_MAX_TOKENS=2048
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Codex: AI_PROVIDER=codex, AI_MODEL=gpt-5.3-codex, OPENAI_API_KEY=<local key>
# Live booking checks are opt-in. Unit checks always use injected, offline transports.
AI_LIVE_TESTS=false
